# ============================================================
# FILE: backend/.env.example
# PURPOSE: All environment variables needed for backend
# COPY to .env and fill in your values. NEVER commit .env to git.
# ============================================================

# -- Server ----------------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:3000    # change to your Vercel URL in production
NODE_ENV=development                   # production, development, staging

# -- Error Tracking (Sentry) ----------------------------------
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx   # Get from sentry.io project settings

# -- JWT -------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_this

# -- Supabase (Chat App DB) -----------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # service_role key

# -- AI API Keys ----------------------------------------------
DEEPSEEK_API_KEY=sk-...                 # platform.deepseek.com -> REQUIRED: powers the default model (deepseek-v4-flash)
GEMINI_API_KEY=AIzaSy...                # Google AI Studio -> free
GROQ_API_KEY=gsk_...                    # console.groq.com -> free tier
MISTRAL_API_KEY=...                     # console.mistral.ai -> free tier
COHERE_API_KEY=...                      # dashboard.cohere.com -> free trial
OPENAI_API_KEY=sk-...                   # platform.openai.com -> paid
ANTHROPIC_API_KEY=sk-ant-...            # console.anthropic.com -> paid

# -- Web Search Providers (fallback order: Exa -> Firecrawl -> Tavily -> SerpAPI; LangSearch aggregate)
EXA_API_KEY=exa_...
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
SERPAPI_API_KEY=...
LANGSEARCH_API_KEY=...
LANGSEARCH_FRESHNESS=noLimit
LANGSEARCH_SUMMARY=true
PARALLEL_API_KEY=...
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_RESULTS=8

# Chat Runtime Tuning (optional)
# OrchestratorBrain adds 2-3 extra LLM calls per message for a planning layer
# whose output no longer changes the reply. Leave false unless you are actively
# working on it; when true its tokens are billed to the user like any other call.
ENABLE_ORCHESTRATOR_BRAIN=false
# Wall-clock budget for the tool loop. Keep it comfortably under the Vercel
# project's Function Max Duration (300s) so persistence and analytics still run
# before the invocation is killed.
CHAT_TIME_BUDGET_MS=240000
# Caps a single AI provider call: total time for non-streaming, idle time
# between chunks for streaming. No provider SDK sets its own timeout. 0 disables.
AI_CALL_TIMEOUT_MS=120000
CHAT_MAX_DB_QUERIES=12
CHAT_MAX_CONSECUTIVE_ZERO_RESULTS=4
CHAT_TOOL_RESERVE_RATIO=0.15
CHAT_SEMANTIC_CACHE_THRESHOLD=0.92
