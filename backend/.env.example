# ============================================================
# FILE: backend/.env.example
# PURPOSE: All environment variables needed for backend
# COPY to .env and fill in your values. NEVER commit .env to git.
# ============================================================

# -- Server ----------------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:3000    # change to your Vercel URL in production
NODE_ENV=development                   # production, development, staging

# -- Error Tracking (Sentry) ----------------------------------
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx   # Get from sentry.io project settings

# -- JWT -------------------------------------------------------
# REQUIRED. Generate one with:  openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# The placeholder below is detected at startup: production exits, development
# auto-generates a temporary secret (with a warning) so first run doesn't crash.
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_this

# -- Supabase (Chat App DB) -----------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # service_role key

# -- AI API Keys ----------------------------------------------
DEEPSEEK_API_KEY=sk-...                 # platform.deepseek.com -> REQUIRED: powers the default model (deepseek-v4-flash)
GEMINI_API_KEY=AIzaSy...                # Google AI Studio -> free
GROQ_API_KEY=gsk_...                    # console.groq.com -> free tier
MISTRAL_API_KEY=...                     # console.mistral.ai -> free tier
COHERE_API_KEY=...                      # dashboard.cohere.com -> free trial
OPENAI_API_KEY=sk-...                   # platform.openai.com -> paid
ANTHROPIC_API_KEY=sk-ant-...            # console.anthropic.com -> paid

# -- Web Search Providers (fallback order: Exa -> Firecrawl -> Tavily -> SerpAPI; LangSearch aggregate)
EXA_API_KEY=exa_...
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
SERPAPI_API_KEY=...
LANGSEARCH_API_KEY=...
LANGSEARCH_FRESHNESS=noLimit
LANGSEARCH_SUMMARY=true
PARALLEL_API_KEY=...
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_RESULTS=8

# Chat Runtime Tuning (optional)
# OrchestratorBrain adds 2-3 extra LLM calls per message for a planning layer
# whose output no longer changes the reply. Leave false unless you are actively
# working on it; when true its tokens are billed to the user like any other call.
ENABLE_ORCHESTRATOR_BRAIN=false
# Wall-clock budget for the tool loop. Keep it comfortably under the Vercel
# project's Function Max Duration (300s) so persistence and analytics still run
# before the invocation is killed.
CHAT_TIME_BUDGET_MS=240000
# Caps a single AI provider call: total time for non-streaming, idle time
# between chunks for streaming. No provider SDK sets its own timeout. 0 disables.
AI_CALL_TIMEOUT_MS=120000
CHAT_MAX_DB_QUERIES=12
CHAT_MAX_CONSECUTIVE_ZERO_RESULTS=4
CHAT_TOOL_RESERVE_RATIO=0.15
CHAT_SEMANTIC_CACHE_THRESHOLD=0.92

# ── Temporal grounding ───────────────────────────────────────
# The current date/time is injected into every system prompt so the model stops
# answering date questions from its training data. See
# backend/services/temporalContext.service.js.
#
# Zone used when the request carries none and the user has saved no preference.
# Deliberately NOT the container's local zone: that is UTC on every serverless
# host, which would answer a Mumbai user in London time. Set it to the
# deployment's primary business timezone (IANA name).
APP_DEFAULT_TIMEZONE=UTC
# How finely "now" is rendered. Prompt caching keys on an exact prefix match, so
# a second-precision clock is a guaranteed cache miss every turn. Raise to
# 300000 (5 min) for a higher cache hit rate on chatty workloads.
TEMPORAL_PRECISION_MS=60000

# ── RAG cross-encoder reranking (Cohere) ─────────────────────
# Reorders knowledge-base retrieval results with a cross-encoder, which reads
# the query and each chunk together rather than comparing them as separate
# embeddings. Uses COHERE_API_KEY above; inactive without it.
# Adds one API call (~100-200ms) per knowledge-base search.
RAG_RERANK_ENABLED=true
COHERE_RERANK_MODEL=rerank-v3.5
RAG_RERANK_TIMEOUT_MS=8000
# Candidates pulled from pgvector before reranking, as a multiple of topK.
# Higher = the reranker can rescue chunks the embedder ranked poorly.
RAG_RERANK_CANDIDATE_MULTIPLIER=5
# Minimum calibrated relevance (0-1) for a passage to be cited as a source.
# Below this the document manifest is still shown, but no passage is quoted.
RAG_RERANK_MIN_RELEVANCE=0.30

# ── RAG query expansion (multi-query) and HyDE ───────────────
# A question and the passage answering it rarely share vocabulary. Expansion
# asks a cheap model for alternate phrasings, retrieves for each, and fuses the
# results by rank. The original query is always kept and searched first.
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_COUNT=3
QUERY_TRANSFORM_MODEL=google/gemini-2.5-flash-lite

# HyDE embeds a hypothetical ANSWER as an extra dense probe, since an answer
# sits closer to a real passage in vector space than a question does. Stronger
# on hard queries, but adds a full generation per turn and a confidently wrong
# hypothesis costs recall. Off by default — measure on your own corpus first.
RAG_HYDE_ENABLED=false

# ── Vision extraction for images in documents ────────────────
# Turns images into searchable text at ingest time. Shared by chat uploads and
# knowledge-base collections.
#
# Free-first: leads with the Mistral free quota and falls through to paid
# Gemini models only when it is exhausted or failing. Set false to lead with
# the strongest model instead.
VISION_PREFER_FREE=true
VISION_FREE_MODEL=mistral-small-latest
VISION_MODEL=google/gemini-2.5-flash-lite

# A rate-limited provider is skipped for this long. Ingest is bursty, so
# without a cooldown a throttled free tier costs a 429 round-trip on every
# remaining image AND the paid call afterwards.
VISION_COOLDOWN_MS=120000

# ── Background-task provider keys ────────────────────────────
# Separate credentials for work the user never sees directly: memory
# summarisation, query rewriting, and vision extraction fallbacks. Keeping them
# apart from the chat keys stops background load competing with user requests
# for the same quota.
#
# These are OPTIONAL, but each one that is missing removes a fallback:
#   - summary.service.js       falls through to naive truncation
#   - queryTransform.service   loses its cross-provider rewrite fallback
#   - visionExtraction.service still gets the free tier via MISTRAL_API_KEY,
#                              but ingest then shares one quota with chat
#
# If unset, the code falls back to the matching primary key
# (MISTRAL_API_KEY / GEMINI_API_KEY). Only the Cerebras entry has no primary
# equivalent and is simply skipped when absent.
GEMINI_SUMMARY_API_KEY=
MISTRAL_SUMMARY_API_KEY=
CEREBRAS_SUMMARY_API_KEY=

# ── PDF OCR fallback ─────────────────────────────────────────
# PDFs are read with pdf-parse first (free, fast, text layer only). OCR runs
# only when that fails or returns implausibly little text, which covers:
#   - scanned pages, which have no text layer at all
#   - PDFs pdf-parse cannot read; its vendored pdf.js is from 2018 and throws
#     "bad XRef entry" on many modern files, including ones this app generates
# OCR also returns markdown, so tables survive as tables.
#
# Billed per page, so it is a fallback, not the default path.
PDF_OCR_ENABLED=true
PDF_OCR_MODEL=mistral-ocr-latest
# Text-layer density below which a PDF is assumed to be scanned.
PDF_OCR_MIN_CHARS_PER_PAGE=100
# Hard cap so a 500-page scan cannot become a 500-page bill.
PDF_OCR_MAX_PAGES=50
PDF_OCR_TIMEOUT_MS=120000
# Where tesseract.js caches eng.traineddata for the offline OCR fallback.
# Defaults to the OS temp dir; tesseract's own default is the deployment
# directory, which is read-only on serverless hosts, so the cache silently
# fails and the model is re-downloaded on every cold start. Set this to a
# persistent volume if you have one.
OCR_CACHE_DIR=

# ── RAPTOR summary tree ──────────────────────────────────────
# Clusters a document's chunks, summarises each cluster, and stores those
# summaries as searchable chunks. Retrieval then covers both levels: a specific
# question matches a passage, a broad one matches a summary.
#
# Trees are NOT built during upload. Vercel Hobby caps a function at 10s by
# default (60s max) and summarising a document costs far more, so build them
# with the CLI instead — it has no timeout:
#
#   node backend/scripts/build-raptor-tree.js --list
#   node backend/scripts/build-raptor-tree.js --all --dry-run
#   node backend/scripts/build-raptor-tree.js --all
#
# The service is resumable, so an API-driven build can also chip away at it
# across several short invocations.
RAPTOR_ENABLED=true
# Children per cluster. Lower = taller tree = more LLM calls.
RAPTOR_BRANCH_FACTOR=5
# Depth cap, counting the original chunks as level 0.
RAPTOR_MAX_LEVELS=3
# Documents smaller than this are skipped — they already fit in a prompt.
RAPTOR_MIN_CHUNKS=8
RAPTOR_CONCURRENCY=3
RAPTOR_FREE_MODEL=mistral-small-latest
RAPTOR_MODEL=google/gemini-2.5-flash-lite
# Score penalty applied to summaries so primary text wins a tie. Synthesis
# should not displace the passage that actually contains the answer.
RAPTOR_SUMMARY_PENALTY=0.05

# ── GraphRAG (entity/relation graph) ─────────────────────────
# Extracts entities and the relations between them, so retrieval can reach an
# answer assembled from two passages — which similarity search cannot do,
# because such an answer is not textually similar to the question.
#
# Graph results are fused by rank alongside the dense and sparse passes, so
# this is another opinion about which chunks matter, not a separate pipeline.
# With no graph built it contributes nothing and costs nothing at query time.
#
# Requires: database/migration_add_knowledge_graph.sql
#
# Build it with the CLI — one LLM call per chunk makes this the most expensive
# job here, so check --dry-run first:
#   node backend/scripts/build-knowledge-graph.js --list
#   node backend/scripts/build-knowledge-graph.js --all --dry-run
#   node backend/scripts/build-knowledge-graph.js --all
GRAPHRAG_ENABLED=true
# Hops out from the entities the query names. 1 covers "A relates to B";
# higher pulls in loosely-connected material and dilutes the candidates.
GRAPHRAG_MAX_HOPS=1
GRAPHRAG_MAX_ENTITIES=8
GRAPHRAG_MAX_RELATIONS=8
GRAPHRAG_CONCURRENCY=3
GRAPHRAG_FREE_MODEL=mistral-small-latest
GRAPHRAG_MODEL=google/gemini-2.5-flash-lite

# Deadline for one API-driven RAPTOR build, kept under the platform's function
# ceiling so the run stops cleanly instead of being killed mid-insert.
RAPTOR_REQUEST_BUDGET_MS=280000

# ── Fallbacks for single-provider paths ──────────────────────
# Reranking: OpenRouter has no rerank endpoint (reranking is not a chat
# operation), so when Cohere is unreachable a chat model scores the candidates
# instead. Ordering still improves; the SCORES are on a scale the model
# invented, so results are flagged uncalibrated and the relevance gate stands
# down rather than thresholding an arbitrary scale.
RAG_RERANK_LLM_MODEL=google/gemini-2.5-flash-lite

# PDF OCR: chat models accepting "file" input read the rendered page, covering
# the same failures the dedicated OCR model does. Used when Mistral OCR is
# unreachable or out of quota.
PDF_OCR_FALLBACK_MODEL=google/gemini-2.5-flash-lite
