{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "services/ai/openrouter.service.js",
    "services/ai/unified.service.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
