{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noResolve": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "config/chatRuntime.config.js",
    "controllers/chat.controller.js",
    "routes/chat.routes.js",
    "services/chatCleanup.service.js",
    "services/documentLoader.service.js",
    "services/rag.service.js",
    "services/toolProcessor.service.js",
    "services/toolLoop.service.js",
    "services/orchestratorBrain.service.js",
    "services/humanApproval.service.js",
    "controllers/approval.controller.js",
    "routes/approval.routes.js",
    "services/ai/dispatcher.service.js",
    "services/tokenAccounting.service.js",
    "services/**/*.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
