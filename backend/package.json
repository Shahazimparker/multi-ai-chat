{
  "name": "multi-ai-chat-backend",
  "version": "1.0.0",
  "description": "Node.js backend for MultiAI Chat Platform",
  "main": "server.js",
  "nodemonConfig": {
    "ignore": [
      "uploads/*"
    ]
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:real": "vitest run --config vitest.real.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@google/generative-ai": "^0.15.0",
    "@sentry/node": "^8.55.2",
    "@supabase/supabase-js": "^2.39.7",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^0.3.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "natural": "^6.10.4",
    "officeparser": "^7.0.3",
    "openai": "^4.28.4",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
