{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noResolve": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "config/chatRuntime.config.js",
    "services/cache.service.js",
    "services/fileUpload.service.js",
    "services/documentLoader.service.js",
    "services/**/*.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
