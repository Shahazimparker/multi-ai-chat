# FILE: frontend/.env.example
# COPY to .env.local for local dev
#
# Vite only exposes variables prefixed with VITE_ to client code.
# (These were REACT_APP_* under Create React App.)

# Backend origin, including the /api suffix.
# NOTE: production also needs this origin listed in the connect-src directive of
# the Content-Security-Policy in frontend/vercel.json, or the browser will block
# every API call. Change one, change the other.
VITE_API_URL=http://localhost:5000/api

# Error Tracking (Sentry) — get from sentry.io project settings
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Minutes of no interaction before the user is signed out. Defaults to 30.
# Separate from the backend's per-user session_minutes, which is an absolute
# cap on session length regardless of activity.
VITE_IDLE_TIMEOUT_MINUTES=30
